            # Medical Record Number near keywords
            r"(?i)(?:mrn|medical\s*record|chart)\s*(?:#|no\.?|number)?\s*:?\s*([A-Z0-9]{5,})",
            "HIGH",
            lambda m: bool(re.search(r"\d", m)),
