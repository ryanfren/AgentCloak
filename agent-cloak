            # Only dates preceded by DOB/birth keywords
            r"(?i)(?:dob|date\s+of\s+birth|birth\s*day|birth\s*date|born)\s*:?\s*(\d{1,2}[/\-]\d{1,2}[/\-]\d{2,4})",
            "HIGH",
            None,
            lambda m: mask_full(m),
