def display_report(findings: list[Finding], show_file: bool = False) -> None:
    """Display the interactive findings report."""
    if not findings:
        print("\n  No sensitive data found.\n")
        return

    # Group by file then category
    files = {}
    for f in findings:
        files.setdefault(f.file_path, []).append(f)

    selected_count = sum(1 for f in findings if f.selected)
    total = len(findings)

    print()
    for file_path, file_findings in files.items():
        if show_file:
            rel = os.path.relpath(file_path)
            print(f"  \033[1;36m--- {rel} ---\033[0m")

        # Group by category within file
        categories = {}
        for f in file_findings:
            categories.setdefault(f.category, []).append(f)

        for cat, cat_findings in categories.items():
            high_count = sum(1 for f in cat_findings if f.confidence == "HIGH")
            med_count = sum(1 for f in cat_findings if f.confidence == "MEDIUM")
            counts = []
            if high_count:
                counts.append(f"{high_count} high")
            if med_count:
                counts.append(f"{med_count} medium")
            print(f"\n  \033[1;33m{cat}\033[0m ({', '.join(counts)})")

            for f in cat_findings:
                idx = findings.index(f) + 1
                sel = "\033[32m[x]\033[0m" if f.selected else "[ ]"
                conf = "" if f.confidence == "HIGH" else f"  \033[2m[{f.confidence.lower()}]\033[0m"
                print(f"  {sel} {idx:>3}. {f.label:<14s} {f.masked_text:<24s} {f.location:<6s} {f.context}{conf}")

    print()
    print(f"  \033[1m{'━' * 60}\033[0m")
    selected_count = sum(1 for f in findings if f.selected)
    print(f"  {total} findings ({selected_count} selected for redaction)")
    print()


def print_help():
    print("  \033[2mCommands:\033[0m")
    print("  \033[2m  1,3,5-8     Toggle specific items\033[0m")
    print("  \033[2m  pii         Toggle all PII items\033[0m")
    print("  \033[2m  financial   Toggle all Financial items\033[0m")
    print("  \033[2m  identifiers Toggle all Identifier items\033[0m")
    print("  \033[2m  secrets     Toggle all Secrets/Tokens items\033[0m")
    print("  \033[2m  all         Select all\033[0m")
    print("  \033[2m  none        Deselect all\033[0m")
    print("  \033[2m  go          Proceed with redaction\033[0m")
    print("  \033[2m  quit        Exit without changes\033[0m")
    print()


def parse_item_spec(spec: str, total: int) -> list[int]:
    """Parse '1,3,5-8' into list of 1-based indices."""
    indices = []
    for part in spec.split(","):
        part = part.strip()
        if "-" in part:
            try:
                a, b = part.split("-", 1)
                a, b = int(a), int(b)
                indices.extend(range(a, b + 1))
            except ValueError:
                pass
        else:
            try:
                indices.append(int(part))
            except ValueError:
                pass
    return [i for i in indices if 1 <= i <= total]


def toggle_findings(findings: list[Finding], command: str) -> bool:
    """Process a toggle command. Returns True if should redact, False to keep prompting, None to quit."""
    cmd = command.strip().lower()

    if cmd in ("go", "done", "redact", "y", "yes"):
        return True
    if cmd in ("quit", "q", "exit", "n", "no"):
        return None
    if cmd == "help":
        print_help()
        return False
    if cmd == "all":
        for f in findings:
            f.selected = True
        return False
    if cmd == "none":
        for f in findings:
            f.selected = False
        return False

    # Category toggle
    cat_map = {
        "pii": "PII",
        "financial": "Financial",
        "fin": "Financial",
        "identifiers": "Identifiers",
        "id": "Identifiers",
        "ids": "Identifiers",
        "secrets": "Secrets/Tokens",
        "tokens": "Secrets/Tokens",
        "keys": "Secrets/Tokens",
    }
    if cmd in cat_map:
        cat = cat_map[cmd]
        cat_findings = [f for f in findings if f.category == cat]
        # If all selected, deselect all. Otherwise select all.
        all_on = all(f.selected for f in cat_findings)
        for f in cat_findings:
            f.selected = not all_on
        return False

    # Number spec: 1,3,5-8
    indices = parse_item_spec(cmd, len(findings))
    if indices:
        for i in indices:
            findings[i - 1].selected = not findings[i - 1].selected
        return False

    print(f"  Unknown command: '{cmd}' (type 'help' for options)")
    return False


# ─── Redaction engine ───────────────────────────────────────────────

def redact_pdf_file(input_path: str, output_path: str, findings: list[Finding]) -> int:
    """Redact selected findings from a PDF file. Returns count redacted."""
    import fitz
    doc = fitz.open(input_path)
    count = 0

    # Group findings by page
    by_page = {}
    for f in findings:
        if f.selected and f.file_path == input_path:
            by_page.setdefault(f.page_num, []).append(f)

    for page_idx, page_findings in by_page.items():
        page = doc[page_idx]
        for f in page_findings:
            instances = page.search_for(f.matched_text)
            for rect in instances:
                page.add_redact_annot(
                    rect,
                    text="",
                    fill=(1, 1, 1),
                )
            count += len(instances)
        page.apply_redactions()

    doc.save(output_path, garbage=4, deflate=True)
    doc.close()
    return count


def redact_text_file(input_path: str, output_path: str, findings: list[Finding]) -> int:
    """Redact selected findings from a text file. Returns count redacted."""
    with open(input_path, "r", errors="replace") as f:
        content = f.read()

    count = 0
    for finding in findings:
        if finding.selected and finding.file_path == input_path:
            # Replace with same-length mask
            replacement = "*" * len(finding.matched_text)
            new_content = content.replace(finding.matched_text, replacement)
            if new_content != content:
                count += content.count(finding.matched_text)
                content = new_content

    with open(output_path, "w") as f:
        f.write(content)

    return count


def make_output_path(input_path: str) -> str:
    """Generate output path: file.pdf -> file-redacted.pdf."""
    p = Path(input_path)
    return str(p.parent / f"{p.stem}-redacted{p.suffix}")


# ─── Manual mode (legacy pdf-redact behavior) ──────────────────────

def manual_mode(input_path: str, output_path: str):
    """Interactive manual string replacement (original pdf-redact behavior)."""
    import fitz

    pairs = []
    print()
    print("=== Manual String Redactor ===")
    print("Enter strings to find/replace. Leave replacement blank to white-out.")
    print("Type 'done' when finished.")
    print()

    while True:
        try:
            find_str = input("Find string (or 'done'): ")
        except (EOFError, KeyboardInterrupt):
            break

        if find_str.lower() == "done":
            break
        if not find_str:
            print("  (empty — skipped)")
            continue

        try:
            replace_str = input("Replace with [blank = white-out]: ")
        except (EOFError, KeyboardInterrupt):
            replace_str = ""

        pairs.append((find_str, replace_str))
        label = replace_str if replace_str else "<blank>"
        print(f"  + '{find_str}' -> '{label}'")
        print()

    if not pairs:
        print("Nothing to replace.")
        return

    print("\nProcessing...")
    doc = fitz.open(input_path)

    for find_str, repl_str in pairs:
        total = 0
        for page in doc:
            instances = page.search_for(find_str)
            total += len(instances)
            for rect in instances:
                page.add_redact_annot(rect, text=repl_str or "", fontsize=0, fill=(1, 1, 1))
            if instances:
                page.apply_redactions()
        print(f"  Replaced {total}x: '{find_str}'")

    doc.save(output_path, garbage=4, deflate=True)
    doc.close()
    print(f"\nDone -> {output_path}")


# ─── Main ───────────────────────────────────────────────────────────

def main():
    import argparse
    parser = argparse.ArgumentParser(
        description="Scan files for sensitive data and interactively redact.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Examples:\n"
               "  agent-cloak invoice.pdf\n"
               "  agent-cloak contracts/\n"
               "  agent-cloak --manual form.pdf\n"
               "  agent-cloak --manual form.pdf -o form-clean.pdf\n",
    )
    parser.add_argument("path", help="File or directory to scan")
    parser.add_argument("-o", "--output", help="Output path (default: <name>-redacted.<ext>)")
    parser.add_argument("--manual", action="store_true", help="Manual string entry mode (no auto-scan)")
    args = parser.parse_args()

    target = Path(args.path)

    if not target.exists():
        print(f"Error: not found: {args.path}", file=sys.stderr)
        sys.exit(1)

    # Manual mode
    if args.manual:
        if target.is_dir():
            print("Error: --manual mode only works with single files", file=sys.stderr)
            sys.exit(1)
        output = args.output or make_output_path(str(target))
        manual_mode(str(target), output)
        return

    # Collect files to scan
    if target.is_dir():
        files = sorted(
            str(p) for p in target.rglob("*")
            if p.is_file() and is_supported(str(p))
        )
        if not files:
            print(f"No supported files found in {args.path}")
            sys.exit(0)
        print(f"\nScanning {len(files)} file(s) in {args.path}...")
    else:
        if not is_supported(str(target)):
            print(f"Error: unsupported file type: {target.suffix}", file=sys.stderr)
            print(f"Supported: PDF, {', '.join(sorted(SUPPORTED_TEXT_EXTENSIONS))}", file=sys.stderr)
            sys.exit(1)
        files = [str(target)]
        print(f"\nScanning {target.name}...")

    # Scan all files
    all_findings = []
    for fpath in files:
        try:
            findings = scan_file(fpath)
            all_findings.extend(findings)
        except Exception as e:
            print(f"  Warning: failed to scan {fpath}: {e}", file=sys.stderr)

    if not all_findings:
        print("\n  No sensitive data found. File appears clean.")
        sys.exit(0)

    show_file = len(files) > 1

    # Display report and interactive selection loop
    display_report(all_findings, show_file=show_file)
    print_help()

    while True:
        try:
            cmd = input("  > ")
        except (EOFError, KeyboardInterrupt):
            print("\n  Cancelled.")
            sys.exit(0)

        result = toggle_findings(all_findings, cmd)
        if result is True:
            break
        if result is None:
            print("  Exiting without changes.")
            sys.exit(0)
        # Redisplay
        display_report(all_findings, show_file=show_file)

    # Apply redactions
    selected = [f for f in all_findings if f.selected]
    if not selected:
        print("  No items selected. Nothing to redact.")
        sys.exit(0)

    # Group by file
    by_file = {}
    for f in selected:
        by_file.setdefault(f.file_path, []).append(f)

    print()
    for fpath, file_findings in by_file.items():
        output = args.output if (args.output and len(by_file) == 1) else make_output_path(fpath)

        try:
            if is_pdf(fpath):
                count = redact_pdf_file(fpath, output, all_findings)
            else:
                count = redact_text_file(fpath, output, all_findings)

            rel_in = os.path.relpath(fpath)
            rel_out = os.path.relpath(output)
            print(f"  {rel_in} -> {rel_out} ({count} redaction(s))")
        except Exception as e:
            print(f"  Error redacting {fpath}: {e}", file=sys.stderr)

    print("\n  Done.")


if __name__ == "__main__":
    main()
