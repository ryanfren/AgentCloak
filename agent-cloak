        (
            "Passport",
            # Near passport keyword: letter + 8 digits, or 9 digits
            r"(?i)passport\s*(?:#|no\.?|number)?\s*:?\s*([A-Z]?\d{8,9})\b",
            "HIGH",
            None,
            mask_partial,
        ),
    ],
    "Financial": [
        (
            "Credit Card",
            r"\b(?:\d{4}[-\s]?){3}\d{4}\b",
            "HIGH",
            lambda m: luhn_check(m),
            mask_cc,
        ),
        (
            "Amex",
            r"\b3[47]\d{2}[-\s]?\d{6}[-\s]?\d{5}\b",
            "HIGH",
            lambda m: luhn_check(m),
            mask_cc,
