        (
            "EIN/Tax ID",
            # Employer Identification Number: XX-XXXXXXX near keywords
            r"(?i)(?:ein|tax\s*(?:id|identification)|employer\s*(?:id|identification))\s*(?:#|no\.?|number)?\s*:?\s*(\d{2}-\d{7})",
            "HIGH",
