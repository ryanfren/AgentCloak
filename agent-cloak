            # Letter + 7-14 digits near DL keywords
            r"(?i)(?:d\.?l\.?|driver'?s?\s*(?:license|lic)|license)\s*(?:#|no\.?|number)?\s*:?\s*([A-Z]\d{7,14})",
            "HIGH",
            None,
            mask_partial,
