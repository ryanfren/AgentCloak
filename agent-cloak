#!/usr/bin/env python3
"""Agent-Cloak — Scan files for sensitive data, report findings, interactively redact.

Supports PDF and plain text files, single files or directories.

Usage:
    agent-cloak <file>              Scan, report, select, redact
    agent-cloak <directory>         Scan all supported files in directory
    agent-cloak --manual <file>     Manual string entry mode (no auto-scan)

Requires: pymupdf (pip install pymupdf) for PDF support.
"""

import re
import sys
import os
from dataclasses import dataclass, field
from pathlib import Path
from typing import Optional


# ─── Finding data class ─────────────────────────────────────────────

@dataclass
class Finding:
    category: str       # PII, Financial, Identifiers
    label: str          # SSN, Email, Credit Card, etc.
    matched_text: str   # the raw matched string
    masked_text: str    # display-safe masked version
    confidence: str     # HIGH or MEDIUM
    file_path: str
    location: str       # "p.1" for PDF page, "L.42" for text line
    context: str        # surrounding text snippet
    selected: bool = True  # pre-selected for redaction?
    page_num: int = -1  # PDF page index (0-based), -1 for text


# ─── Luhn check for credit card validation ──────────────────────────

def luhn_check(number: str) -> bool:
    """Validate a number string with the Luhn algorithm."""
    digits = [int(d) for d in number if d.isdigit()]
    if len(digits) < 13:
        return False
    checksum = 0
    reverse = digits[::-1]
    for i, d in enumerate(reverse):
        if i % 2 == 1:
            d *= 2
            if d > 9:
                d -= 9
        checksum += d
    return checksum % 10 == 0


# ─── Pattern definitions ────────────────────────────────────────────
# Each pattern: (label, regex, confidence, validator_fn_or_None, mask_fn)

def mask_ssn(m: str) -> str:
    return "***-**-" + m[-4:]

def mask_email(m: str) -> str:
    parts = m.split("@")
    return "****@" + parts[1] if len(parts) == 2 else "****"

def mask_phone(m: str) -> str:
    digits = re.sub(r"\D", "", m)
    return "(***) ***-" + digits[-4:]

def mask_cc(m: str) -> str:
    digits = re.sub(r"\D", "", m)
    return "****-****-****-" + digits[-4:]

def mask_partial(m: str) -> str:
    if len(m) <= 4:
        return "*" * len(m)
    return "*" * (len(m) - 4) + m[-4:]

def mask_full(m: str) -> str:
    return "*" * len(m)

def mask_token(m: str) -> str:
    if len(m) <= 8:
        return "*" * len(m)
    return m[:4] + "*" * (len(m) - 8) + m[-4:]

def mask_jwt(m: str) -> str:
    parts = m.split(".")
    if len(parts) == 3:
        return parts[0][:10] + "...<redacted>"
    return m[:10] + "...<redacted>"


PATTERNS = {
