        (
            "SSN (no dashes)",
            # 9 consecutive digits near SSN/social keywords
            r"(?i)(?:ssn|social\s*security|social)\s*(?:#|no\.?|number)?\s*:?\s*(\d{9})\b",
            "HIGH",
            lambda m: not re.match(r"^(000|666)", m),
            lambda m: mask_ssn(m[:3] + "-" + m[3:5] + "-" + m[5:]),
        ),
        (
            "SSN (last 4)",
            # Partial SSNs: xx-1234, XX-1234, ***-**-1234, xxx-xx-1234, etc.
            r"(?i)(?:[x*]{2,3}[-\s]?[x*]{2}[-\s]?\d{4}|[x*]{2,3}[-\s]?\d{4}|(?:last\s*4|ssn.*last|last.*ssn)\s*:?\s*\d{4})\b",
            "HIGH",
            None,
            lambda m: mask_full(m),
        ),
        (
            "Email",
            # Negative lookbehind: don't match user:pass@host inside credential URLs
            r"(?<!:)\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b",
